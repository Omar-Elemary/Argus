# =====================================================================
# Argus - environment configuration
# Copy this file to `backend/.env` (or your shell environment) and fill
# in the values. NEVER commit real secrets.
# =====================================================================

# --- Application -----------------------------------------------------
APP_NAME=argus
ENV=development
LOG_LEVEL=INFO

# --- Ethereum RPC ----------------------------------------------------
# Required for blockchain tools. Sepolia and Mainnet both work.
# Examples:
#   Sepolia (Alchemy): https://eth-sepolia.g.alchemy.com/v2/<KEY>
#   Sepolia (Infura):  https://sepolia.infura.io/v3/<KEY>
#   Mainnet:           https://eth-mainnet.g.alchemy.com/v2/<KEY>
ETH_RPC_URL=
# "sepolia" or "mainnet". Controls default chain-id validation.
ETH_NETWORK=sepolia
# Optional explicit chain id (11155111 = Sepolia, 1 = Mainnet).
# When 0/empty, Argus auto-detects the chain id from the RPC.
ETH_CHAIN_ID=0

# Optional: Etherscan API key enables the pluggable transaction indexer
# that returns complete address history (RPC-only mode uses a bounded
# block-scan indexer instead).
ETHERSCAN_API_KEY=

# --- RPC reliability -------------------------------------------------
RPC_TIMEOUT_SECONDS=15
RPC_RETRIES=3
# Base delay for exponential backoff between retries (seconds).
RPC_RETRY_BACKOFF=0.5
# Minimum interval between RPC calls (rate-limit protection), ms.
RPC_MIN_INTERVAL_MS=60
# Ceiling on blocks scanned by the block-scan transaction indexer.
MAX_BLOCKS_SCAN=200
# Per-investigation transaction results kept for analysis.
MAX_TRANSACTIONS=50

# --- Agent limits ----------------------------------------------------
# Hard caps so the orchestrator can never loop or burn unbounded budget.
MAX_ITERATIONS=3
MAX_TOOL_CALLS=30

# --- LLM (agent narrative) -------------------------------------------
# Provider is pluggable. "auto" picks the first configured backend:
#   openai  -> OpenAI / OpenRouter / any OpenAI-compatible endpoint
#   cursor  -> Cursor Cloud Agents API (api.cursor.com, no-repo agents)
#   none    -> deterministic fallback narratives (no external calls)
# A model example for OpenAI: gpt-4o-mini
LLM_PROVIDER=auto
LLM_MODEL=
LLM_API_KEY=
# Base URL for OpenAI-compatible endpoints (OpenAI default, OpenRouter,
# local vLLM/Ollama, etc.)
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# --- Cursor Cloud Agents (alternative to OpenAI-compatible) ----------
# Cursor exposes a Cloud Agents API rather than a chat-completions
# endpoint. Set LLM_PROVIDER=cursor and CURSOR_API_KEY to drive report
# narration through Cursor cloud agents. API keys come from
# https://cursor.com/dashboard/api (format: crsr_...).
CURSOR_API_KEY=
CURSOR_BASE_URL=https://api.cursor.com/v0
# GitHub repository the Cursor API key can access. Cloud agents run
# against this repo (required for agent creation).
CURSOR_REPOSITORY=

# --- Analysis thresholds --------------------------------------------
# ETH value above which a transaction is flagged as "unusually large".
LARGE_TX_THRESHOLD_ETH=10.0
# Minimum count of counterparty repeats to be reported.
REPEATED_COUNTERPARTY_MIN=3

# --- Persistence (Phase 2) ------------------------------------------
# Postgres is optional for the MVP. When set, result persistence can be
# enabled behind a documented adapter (pgvector is reserved for RAG).
DATABASE_URL=

# --- Frontend --------------------------------------------------------
FRONTEND_DIR=../frontend