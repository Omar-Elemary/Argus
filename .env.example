# Fellows — copy to backend/.env or export in your shell.
# NEVER commit real secrets.

# --- Application -----------------------------------------------------
APP_NAME=fellows
ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ------------------------------------------------------
# Local default uses SQLite if you omit this. Compose sets Postgres.
DATABASE_URL=postgresql+asyncpg://fellows:fellows@localhost:5432/fellows

# --- Redis (Phase 5 realtime; optional in Phase 1) -------------------
REDIS_URL=redis://localhost:6379/0

# --- Orchestration budgets (Phase 4) ---------------------------------
MAX_ITERATIONS=8
MAX_TOOL_CALLS=40

# --- LLM (unused for Phase 1 company/auth; required later for agents)
# auto | openai | cursor | none
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
CURSOR_API_KEY=
CURSOR_BASE_URL=https://api.cursor.com/v0
CURSOR_REPOSITORY=
